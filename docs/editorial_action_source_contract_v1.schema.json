{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://political-fingerprint.local/schemas/editorial_action_source_contract_v1.schema.json",
  "title": "Editorial exact-action source contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "source_manifest", "claim_source_map", "source_authorities", "actions"],
  "properties": {
    "schema_version": {"const": "editorial_action_source_contract_v1"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_:-]+$"},
    "source_manifest": {"$ref": "#/definitions/governedReference"},
    "claim_source_map": {"$ref": "#/definitions/governedReference"},
    "source_authorities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_:-]+$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^house:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*$"
      },
      "additionalProperties": {"$ref": "#/definitions/actionRequirement"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "governedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "actionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vote_source_refs", "action_meaning_source_refs", "required_action_meaning_source_types"],
      "properties": {
        "vote_source_refs": {"$ref": "#/definitions/uniqueStrings"},
        "action_meaning_source_refs": {"$ref": "#/definitions/uniqueStrings"},
        "required_action_meaning_source_types": {"$ref": "#/definitions/uniqueStrings"}
      }
    }
  }
}
