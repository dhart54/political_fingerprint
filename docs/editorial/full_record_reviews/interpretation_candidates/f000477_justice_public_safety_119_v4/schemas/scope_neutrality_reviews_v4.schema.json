            "type": "object"
          },
          "content_subject_sha256": {
            "type": "string"
          },
          "final_candidate_content_subject_sha256": {
            "type": "string"
          },
          "final_routing": {
            "type": "string"
          },
          "findings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "finding": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              },
              "required": [
                "finding",
                "severity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "highest_severity": {
            "type": "string"
          },
          "initial_candidate_content_subject_sha256": {
            "type": "string"
          },
          "remaining_severity_after_routing": {
            "type": "string"
          },
          "review_contract_version": {
            "type": "string"
          },
          "review_id": {
            "type": "string"
          },
          "reviewer_cannot_accept": {
            "type": "boolean"
