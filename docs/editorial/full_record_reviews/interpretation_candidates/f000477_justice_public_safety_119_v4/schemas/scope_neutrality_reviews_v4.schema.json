          "findings",
          "highest_severity",
          "initial_candidate_content_subject_sha256",
          "remaining_severity_after_routing",
          "review_contract_version",
          "review_id",
          "reviewer_cannot_accept",
          "reviewer_role",
          "scope_recommendation"
