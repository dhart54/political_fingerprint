    },
    "review_count": {
      "type": "integer"
    },
    "reviews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string"
          },
          "benchmark_used": {
            "type": "boolean"
          },
          "checks": {
            "additionalProperties": false,
            "properties": {
              "cross_domain_limits_preserved": {
                "type": "boolean"
              },
              "exact_action_only": {
                "type": "boolean"
              },
              "no_episode_synthesis_or_public_copy": {
                "type": "boolean"
              },
              "no_party_or_motive_claim": {
                "type": "boolean"
              },
              "official_member_action_preserved": {
                "type": "boolean"
              },
              "required_uncertainty_routing_preserved": {
                "type": "boolean"
              }
            },
            "required": [
              "cross_domain_limits_preserved",
              "exact_action_only",
              "no_episode_synthesis_or_public_copy",
              "no_party_or_motive_claim",
              "official_member_action_preserved",
              "required_uncertainty_routing_preserved"
