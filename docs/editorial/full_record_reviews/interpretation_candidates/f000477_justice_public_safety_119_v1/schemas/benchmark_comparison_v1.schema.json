{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_batch_subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "comparison_count": {
      "const": 7
    },
    "comparisons": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted_reference_id": {
            "minLength": 1,
            "type": "string"
          },
          "accepted_reference_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "action_id": {
            "minLength": 1,
            "type": "string"
          },
          "action_identity_agreement": {
            "type": "boolean"
          },
          "candidate_id": {
            "minLength": 1,
            "type": "string"
          },
          "candidate_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "evaluation_only_no_candidate_mutation": {
            "const": true
          },
          "explanation": {
            "minLength": 1,
            "type": "string"
          },
          "limitation_agreement": {
            "type": "boolean"
          },
          "member_action_agreement": {
            "type": "boolean"
          },
          "scope_agreement": {
            "type": "boolean"
          },
          "semantic_relationship": {
            "enum": [
              "aligned",
              "acceptably_narrower",
              "broader_than_reference",
              "materially_different",
              "conflicting",
              "no_safe_comparison"
            ]
          },
          "severity": {
            "enum": [
              "none",
              "minor",
              "major",
              "critical"
            ]
          },
          "stage_agreement": {
            "type": "boolean"
          }
        },
        "required": [
          "action_id",
          "candidate_id",
          "candidate_sha256",
          "accepted_reference_id",
          "accepted_reference_sha256",
          "action_identity_agreement",
          "stage_agreement",
          "member_action_agreement",
          "semantic_relationship",
          "limitation_agreement",
          "scope_agreement",
          "severity",
          "explanation",
          "evaluation_only_no_candidate_mutation"
        ],
        "type": "object"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "non_authorizing": {
      "const": true
    },
    "post_freeze_only": {
      "const": true
    },
    "schema_version": {
      "const": "action_interpretation_benchmark_comparison_v1"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "non_authorizing",
    "post_freeze_only",
    "candidate_batch_subject_sha256",
    "comparison_count",
    "comparisons",
    "artifact_sha256"
  ],
  "type": "object"
}
