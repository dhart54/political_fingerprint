{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "canonical_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "dossier_path": {
      "minLength": 1,
      "type": "string"
    },
    "dossier_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "field_group_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "parity_state": {
      "const": "pass"
    },
    "schema_version": {
      "const": "action_interpretation_json_markdown_parity_v1"
    },
    "substantive_projection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "parity_state",
    "canonical_artifacts",
    "dossier_path",
    "dossier_sha256",
    "substantive_projection_sha256",
    "field_group_sha256",
    "artifact_sha256"
  ],
  "type": "object"
}
