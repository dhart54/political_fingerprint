{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "bundle_content_subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "content_subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "non_authorizing": {
      "const": true
    },
    "recommendation_count": {
      "const": 37
    },
    "recommendation_counts": {
      "additionalProperties": false,
      "properties": {
        "recommend_accept": {
          "type": "integer"
        },
        "recommend_accept_with_revision": {
          "type": "integer"
        },
        "recommend_preserve_ambiguous": {
          "type": "integer"
        },
        "recommend_preserve_no_safe_candidate": {
          "type": "integer"
        }
      },
      "required": [
        "recommend_accept",
        "recommend_accept_with_revision",
        "recommend_preserve_ambiguous",
        "recommend_preserve_no_safe_candidate"
      ],
      "type": "object"
    },
    "recommendations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string"
          },
          "content_subject_sha256": {
            "type": "string"
          },
          "decision_unit_content_subject_sha256": {
            "type": "string"
          },
          "human_decision_selected": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "content_subject_sha256",
          "decision_unit_content_subject_sha256",
          "human_decision_selected",
          "rationale",
          "recommendation"
        ],
        "type": "object"
      },
      "maxItems": 37,
      "minItems": 37,
      "type": "array"
    },
    "recommendations_are_human_decisions": {
      "const": false
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "non_authorizing",
    "content_subject_sha256",
    "bundle_content_subject_sha256",
    "recommendation_count",
    "recommendations_are_human_decisions",
    "recommendations",
    "recommendation_counts"
  ],
  "type": "object"
}
