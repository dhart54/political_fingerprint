      ],
      "constraint_id": "candidate-episode-hold",
      "detail": "Hold the paired H.R.1048 authored 79/83 episode for independent candidate/package review. Passage 83 exact qualification and vote-time package are reconstructed as a candidate, not editorially accepted; no component preference, individual legal application or new behavioral proposition.",
      "semantic_effect": "blocks_behavioral_propositions"
    },
    {
      "action_ids": [
        "house:119:2:244"
      ],
      "constraint_id": "source:house119-session2-roll244-immigration-attribution",
      "detail": "Limit Immigration & Border attribution to the explicit $50 million reduction to the United States Emergency Refugee and Migration Assistance Fund (ERMA), compared with the proposed $100 million appropriation. Preserve the Jordan funding prohibition and all eight named reductions as one combined amendment choice; a member vote does not establish separate component positions or Immigration meaning for every foreign-assistance account. Reserve application of the Jordan prohibition in light of 22 USC2601(f); do not conclude that either restriction automatically overrides the other. This application reservation does not make the independent literal ERMA reduction contingent or block the whole-choice behavioral finding.",
      "semantic_effect": "bounds_cross_domain_attribution"
    },
    {
      "action_ids": [
        "house:119:1:79"
      ],
      "constraint_id": "source:house119-session1-roll79-immigration-attribution",
      "detail": "Limit Immigration attribution to the removed proposed personal translator qualification and its complete donor/country/citizenship/foreign-source chain. Preserve the whole substitute and baseline, all source limbs and retained English translation duties. No current-law repeal, universal translator eligibility or component preference. Agency and individual country application remain reserved; episode held pending passage83review.",
      "semantic_effect": "bounds_cross_domain_attribution"
    },
    {
      "action_ids": [
        "house:119:1:83"
      ],
      "constraint_id": "source:house119-session1-roll83-immigration-attribution",
      "detail": "Limit Immigration attribution to the proposed qualified personal translator condition with complete donor/country/citizenship and all foreign-source/agency limbs. Preserve whole package, prior adopted modifications and exact final-passage sequence. No enactment, blanket translator eligibility, current-law or individual designation/application claim; no separate component preference. Hold paired 79/83 episode for independent candidate/package review.",
      "semantic_effect": "bounds_cross_domain_attribution"
    },
    {
      "action_ids": [
        "house:119:2:280"
      ],
      "constraint_id": "source:house119-session2-roll280-immigration-attribution",
      "detail": "Limit Immigration attribution to the citizenship/nationality/residence-qualified second dependent-child coverage path in the proposed Member-family investment regime. Preserve independent under21 household coverage, spouse coverage and all dependency/adoption exceptions. PhotoID/stock/ethics context is not separate Immigration meaning, and the whole-package vote supplies no component stance. Tax residence does not prove lawful Immigration status; no individual or enactment determination.",
      "semantic_effect": "bounds_cross_domain_attribution"
    },
    {
