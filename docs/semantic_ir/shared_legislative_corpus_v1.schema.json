{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politicalfingerprint.example/schemas/shared_legislative_corpus_v1.schema.json",
  "title": "Political Fingerprint Shared Legislative Corpus V1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_type", "text_version", "raw_sha256", "governed_bytes_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "text_version": {"type": ["string", "null"]},
        "raw_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "governed_bytes_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sharedAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "exact_action_identity", "chamber", "congress", "session", "roll", "legislative_stage", "action_date", "chamber_outcome", "enactment_status", "mechanism", "mechanism_availability", "accepted_exact_action_meaning", "accepted_shared_limitations", "action_meaning_ref", "governed_source_identities", "governed_source_identity_sha256", "action_outcome_source_identities", "operative_meaning_source_identities", "semantic_ir_source_ids", "package_component_boundary", "source_contract_version", "meaning_contract_version", "action_core_sha256"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^house:[0-9]+:[0-9]+:[0-9]+$"},
        "exact_action_identity": {"type": "string", "minLength": 1},
        "chamber": {"const": "house"}, "congress": {"type": "integer"}, "session": {"type": "integer"}, "roll": {"type": "integer"},
        "legislative_stage": {"type": "string", "minLength": 1}, "action_date": {"type": "string", "format": "date"},
        "chamber_outcome": {"type": "string", "minLength": 1}, "enactment_status": {"const": "not_inferred_from_house_outcome"},
        "mechanism": {"type": ["string", "null"]}, "mechanism_availability": {"type": "string", "minLength": 1},
        "accepted_exact_action_meaning": {"type": ["string", "null"], "minLength": 1},
        "accepted_shared_limitations": {"type": "array", "items": {"type": "string"}},
        "action_meaning_ref": {"type": "string", "minLength": 1},
        "governed_source_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceIdentity"}},
        "governed_source_identity_sha256": {"$ref": "#/$defs/sha256"},
        "action_outcome_source_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceIdentity"}},
        "operative_meaning_source_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceIdentity"}},
        "semantic_ir_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "package_component_boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["boundary_type", "parent_package_meaning_projected", "basis"],
          "properties": {
            "boundary_type": {"type": "string"}, "parent_package_meaning_projected": {"const": false},
            "basis": {"type": ["string", "array"]},
            "governed_component_relationships": {"type": "array", "items": {"type": "string"}}
          }
        },
        "source_contract_version": {"type": "string"}, "meaning_contract_version": {"type": "string"},
        "action_core_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sharedActionCoreArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "identity_unit", "authoritative_for_new_editorial_work", "historical_inputs_rewritten", "actions", "corpus_sha256"],
      "properties": {
        "schema_version": {"const": "shared_action_core_v1"}, "artifact_id": {"type": "string"},
        "identity_unit": {"const": "exact House legislative action and governed source version"},
        "authoritative_for_new_editorial_work": {"const": true}, "historical_inputs_rewritten": {"const": false},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sharedAction"}},
        "corpus_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actionMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "eligibility", "episode_id", "policy_family_refs", "policy_trait_refs", "structural_metadata", "mapping_sha256"],
      "properties": {
        "action_id": {"type": "string"},
        "eligibility": {"type": "object", "additionalProperties": false, "required": ["decision", "parent_context_used"], "properties": {"decision": {"type": "string"}, "parent_context_used": {"type": "boolean"}}},
        "episode_id": {"type": ["string", "null"]}, "policy_family_refs": {"type": "array", "items": {"type": "string"}},
        "policy_trait_refs": {"type": "array", "items": {"type": "string"}}, "structural_metadata": {"type": "object"},
        "mapping_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_id", "action_ids", "method_boundary_types", "policy_family_id"],
      "properties": {
        "episode_id": {"type": "string"}, "action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "method_boundary_types": {"type": "array", "items": {"type": "string"}}, "policy_family_id": {"type": ["string", "null"]}
      }
    },
    "policyFamily": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_family_id", "episode_ids"],
      "properties": {"policy_family_id": {"type": "string"}, "episode_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "policyTrait": {
      "type": "object", "additionalProperties": false,
      "required": ["trait_id", "action_ids", "meaning_ref", "review_state"],
      "properties": {"trait_id": {"type": "string"}, "action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "meaning_ref": {"type": "string"}, "review_state": {"type": "string"}}
    },
    "traitRelationship": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "relationship", "right", "review_state"],
      "properties": {"left": {"type": "string"}, "relationship": {"type": "string"}, "right": {"type": "string"}, "review_state": {"type": "string"}}
    },
    "reviewDependency": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "content_subject_sha256", "dependency_id", "review_route"],
      "properties": {"artifact_id": {"type": "string"}, "content_subject_sha256": {"$ref": "#/$defs/sha256"}, "dependency_id": {"type": "string"}, "review_route": {"type": "string"}}
    },
    "sourceConstraint": {
      "type": "object", "additionalProperties": false,
      "required": ["action_ids", "constraint_id", "detail", "semantic_effect"],
      "properties": {"action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "constraint_id": {"type": "string"}, "detail": {"type": "string"}, "semantic_effect": {"type": "string"}}
    },
    "sharedIssueMappingArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "domain_id", "scope_boundaries", "authoritative_for_new_editorial_work", "historical_inputs_rewritten", "semantic_ir_case_scope", "action_mappings", "episodes", "policy_families", "policy_traits", "trait_relationships", "shared_review_dependencies", "source_render_constraints", "mapping_sha256"],
      "properties": {
        "schema_version": {"const": "shared_issue_mapping_v1"}, "artifact_id": {"type": "string"}, "domain_id": {"type": "string"},
        "scope_boundaries": {"type": "array", "items": {"type": "string"}}, "authoritative_for_new_editorial_work": {"const": true}, "historical_inputs_rewritten": {"const": false},
        "semantic_ir_case_scope": {"type": ["object", "string"]}, "action_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actionMapping"}},
        "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}}, "policy_families": {"type": "array", "items": {"$ref": "#/$defs/policyFamily"}},
        "policy_traits": {"type": "array", "items": {"$ref": "#/$defs/policyTrait"}}, "trait_relationships": {"type": "array", "items": {"$ref": "#/$defs/traitRelationship"}},
        "shared_review_dependencies": {"type": "array", "items": {"$ref": "#/$defs/reviewDependency"}}, "source_render_constraints": {"type": "array", "items": {"$ref": "#/$defs/sourceConstraint"}},
        "mapping_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "memberAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action_core_sha256", "shared_issue_mapping_sha256", "official_status", "service_status", "evidence_status", "exact_choice_effect", "member_action_source_identities", "member_action_source_identity_sha256"],
      "properties": {
        "action_id": {"type": "string"}, "action_core_sha256": {"$ref": "#/$defs/sha256"}, "shared_issue_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "official_status": {"enum": ["Yea", "Nay", "Present", "Not Voting", "Missing Evidence"]},
        "service_status": {"type": "string"}, "evidence_status": {"type": "string"},
        "exact_choice_effect": {"enum": ["supports_exact_choice", "opposes_exact_choice", "resolved_non_directional", "missing_evidence"]},
        "member_action_source_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceIdentity"}},
        "member_action_source_identity_sha256": {"$ref": "#/$defs/sha256"}, "component_ref": {"type": "string"}
      }
    },
    "memberActionProjectionArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "member_id", "party", "context_metadata", "authoritative_legislative_meaning", "actions", "projection_sha256"],
      "properties": {
        "schema_version": {"const": "member_action_projection_v1"}, "artifact_id": {"type": "string"}, "member_id": {"type": "string"}, "party": {"type": "string"},
        "context_metadata": {"type": "object"}, "authoritative_legislative_meaning": {"const": false},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/memberAction"}},
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
