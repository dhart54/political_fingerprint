{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politicalfingerprint.org/schemas/editorial_publication_activation_bundle_v1.schema.json",
  "title": "Editorial publication activation bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "deterministic_batch_key",
    "source_commit_sha",
    "target_environment_class",
    "historical_seed",
    "pre_activation_baseline",
    "activation_target",
    "artifacts",
    "relationships",
    "publication_registry",
    "expected_counts",
    "rollback_identity",
    "public_smoke_contract",
    "semantic_hashes",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "editorial_publication_activation_bundle_v1"
    },
    "bundle_id": {
      "const": "foushee_justice_public_safety_119_publication_activation_v1"
    },
    "deterministic_batch_key": {
      "type": "string",
      "minLength": 1
    },
    "source_commit_sha": {
      "$ref": "#/$defs/sha40"
    },
    "target_environment_class": {
      "const": "production_postgresql"
    },
    "historical_seed": {
      "type": "object",
      "required": ["deterministic_batch_key", "manifest_sha256", "expected_counts"]
    },
    "pre_activation_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expected_counts",
        "governed_batches",
        "portable_semantic_hashes",
        "reconciled_production_fingerprint",
        "target_absence"
      ],
      "properties": {
        "schema_version": {
          "const": "editorial_publication_pre_activation_baseline_v1"
        },
        "expected_counts": {"$ref": "#/$defs/counts"},
        "governed_batches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/governed_batch"}
        },
        "portable_semantic_hashes": {"$ref": "#/$defs/hash_pair"},
        "reconciled_production_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_object_sha256",
            "artifact_set_sha256",
            "relationship_set_sha256",
            "registry_sha256",
            "fingerprint_sha256"
          ],
          "properties": {
            "schema_object_sha256": {"$ref": "#/$defs/sha256"},
            "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
            "relationship_set_sha256": {"$ref": "#/$defs/sha256"},
            "registry_sha256": {"$ref": "#/$defs/sha256"},
            "fingerprint_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "target_absence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "natural_keys",
            "content_sha256",
            "activation_batch_key",
            "registry_primary_key"
          ],
          "properties": {
            "natural_keys": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "string"}
            },
            "content_sha256": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"$ref": "#/$defs/sha256"}
            },
            "activation_batch_key": {"type": "string", "minLength": 1},
            "registry_primary_key": {
              "type": "object",
              "additionalProperties": false,
              "required": ["member_bioguide_id", "issue_id"],
              "properties": {
                "member_bioguide_id": {"type": "string", "minLength": 1},
                "issue_id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "activation_target": {
      "type": "object",
      "required": [
        "member_bioguide_id",
        "issue_id",
        "congress",
        "scope",
        "presentation_natural_key",
        "presentation_artifact_version",
        "approval_receipt_id",
        "approval_subject_sha256",
        "presentation_content_sha256",
        "active_artifact_sha256",
        "inactive_artifact_sha256",
        "detached_approval_receipt_sha256",
        "action_source_contract_id",
        "action_source_contract_sha256",
        "limitations_sha256"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "publication_registry": {
      "type": "object",
      "required": [
        "member_bioguide_id",
        "issue_id",
        "presentation_natural_key",
        "presentation_artifact_version",
        "publicly_active",
        "publication_metadata"
      ]
    },
    "expected_counts": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": {
          "$ref": "#/$defs/counts"
        },
        "after": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "rollback_identity": {
      "type": "object",
      "required": [
        "deterministic_batch_key",
        "artifact_versions",
        "relationship_sha256",
        "registry_primary_key",
        "approval_receipt_id",
        "restore_expected_counts",
        "deletion_order"
      ]
    },
    "public_smoke_contract": {
      "type": "object",
      "required": ["before", "after", "approved_counts", "cross_identity"]
    },
    "semantic_hashes": {
      "type": "object",
      "required": [
        "artifacts_sha256",
        "relationships_sha256",
        "publication_registry_sha256"
      ]
    },
    "bundle_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batches", "artifacts", "relationships", "publication_registry"],
      "properties": {
        "batches": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "integer", "minimum": 0},
        "relationships": {"type": "integer", "minimum": 0},
        "publication_registry": {"type": "integer", "minimum": 0}
      }
    },
    "hash_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts_sha256", "relationships_sha256"],
      "properties": {
        "artifacts_sha256": {"$ref": "#/$defs/sha256"},
        "relationships_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "governed_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_batch_id",
        "deterministic_batch_key",
        "source_commit_sha",
        "manifest_sha256",
        "status",
        "artifact_count",
        "relationship_count",
        "artifact_semantic_sha256",
        "relationship_semantic_sha256",
        "portable_graph_sha256",
        "reconciled_graph_sha256"
      ],
      "properties": {
        "database_batch_id": {"type": "integer", "minimum": 1},
        "deterministic_batch_key": {"type": "string", "minLength": 1},
        "source_commit_sha": {"$ref": "#/$defs/sha40"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "applied"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "artifact_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "relationship_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "portable_graph_sha256": {"$ref": "#/$defs/sha256"},
        "reconciled_graph_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_type",
        "natural_key",
        "schema_version",
        "artifact_version",
        "payload",
        "content_sha256",
        "source_manifest_sha256",
        "source_commit_sha",
        "member_bioguide_id",
        "issue_id",
        "congress",
        "chamber",
        "editorial_status",
        "benchmark_status",
        "production_eligible",
        "review_route"
      ],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit_sha": {"$ref": "#/$defs/sha40"},
        "payload": {"type": "object"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_natural_key",
        "child_natural_key",
        "relationship_type",
        "ordinal",
        "metadata"
      ],
      "properties": {
        "parent_natural_key": {"type": "string"},
        "child_natural_key": {"type": "string"},
        "relationship_type": {
          "enum": ["has_validation", "uses_source_manifest"]
        },
        "ordinal": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object"}
      }
    }
  }
}
