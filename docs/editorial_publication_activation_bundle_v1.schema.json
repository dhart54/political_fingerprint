{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politicalfingerprint.org/schemas/editorial_publication_activation_bundle_v1.schema.json",
  "title": "Editorial publication activation bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "deterministic_batch_key",
    "source_commit_sha",
    "target_environment_class",
    "historical_seed",
    "pre_activation_baseline",
    "activation_target",
    "artifacts",
    "relationships",
    "publication_registry",
    "expected_counts",
    "rollback_identity",
    "public_smoke_contract",
    "semantic_hashes",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "editorial_publication_activation_bundle_v1"
    },
    "bundle_id": {
      "const": "foushee_justice_public_safety_119_publication_activation_v1"
    },
    "deterministic_batch_key": {
      "type": "string",
      "minLength": 1
    },
    "source_commit_sha": {
      "$ref": "#/$defs/sha40"
    },
    "target_environment_class": {
      "const": "production_postgresql"
    },
    "historical_seed": {
      "type": "object",
      "required": ["deterministic_batch_key", "manifest_sha256", "expected_counts"]
    },
    "pre_activation_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expected_counts",
        "governed_batches",
        "canonical_semantic_hashes",
        "reconciliation_evidence",
        "target_absence",
        "reconciled_fingerprint"
      ],
      "properties": {
        "schema_version": {
          "const": "editorial_publication_pre_activation_baseline_v1"
        },
        "expected_counts": {"$ref": "#/$defs/counts"},
        "governed_batches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/governed_batch"}
        },
        "canonical_semantic_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifacts_sha256", "relationships_sha256", "registry_sha256"],
          "properties": {
            "artifacts_sha256": {"$ref": "#/$defs/sha256"},
            "relationships_sha256": {"$ref": "#/$defs/sha256"},
            "registry_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "reconciliation_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report_sha256",
            "prior_environment_bound_fingerprint_sha256",
            "normalization_resolution"
          ],
          "properties": {
            "report_sha256": {"$ref": "#/$defs/sha256"},
            "prior_environment_bound_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
            "normalization_resolution": {"const": "canonical_semantic_normalization_v1"}
          }
        },
        "target_absence": {"$ref": "#/$defs/target_absence"},
        "reconciled_fingerprint": {"$ref": "#/$defs/reconciled_fingerprint"}
      }
    },
    "activation_target": {
      "type": "object",
      "required": [
        "member_bioguide_id",
        "issue_id",
        "congress",
        "scope",
        "presentation_natural_key",
        "presentation_artifact_version",
        "approval_receipt_id",
        "approval_subject_sha256",
        "presentation_content_sha256",
        "active_artifact_sha256",
        "inactive_artifact_sha256",
        "detached_approval_receipt_sha256",
        "action_source_contract_id",
        "action_source_contract_sha256",
        "limitations_sha256"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "publication_registry": {
      "type": "object",
      "required": [
        "member_bioguide_id",
        "issue_id",
        "presentation_natural_key",
        "presentation_artifact_version",
        "publicly_active",
        "publication_metadata"
      ]
    },
    "expected_counts": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": {
          "$ref": "#/$defs/counts"
        },
        "after": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "rollback_identity": {
      "type": "object",
      "required": [
        "deterministic_batch_key",
        "artifact_versions",
        "relationship_sha256",
        "registry_primary_key",
        "approval_receipt_id",
        "restore_expected_counts",
        "deletion_order"
      ]
    },
    "public_smoke_contract": {
      "type": "object",
      "required": ["before", "after", "approved_counts", "cross_identity"]
    },
    "semantic_hashes": {
      "type": "object",
      "required": [
        "artifacts_sha256",
        "relationships_sha256",
        "publication_registry_sha256"
      ]
    },
    "bundle_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batches", "artifacts", "relationships", "publication_registry"],
      "properties": {
        "batches": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "integer", "minimum": 0},
        "relationships": {"type": "integer", "minimum": 0},
        "publication_registry": {"type": "integer", "minimum": 0}
      }
    },
    "hash_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts_sha256", "relationships_sha256"],
      "properties": {
        "artifacts_sha256": {"$ref": "#/$defs/sha256"},
        "relationships_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "governed_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_batch_id",
        "deterministic_batch_key",
        "source_commit_sha",
        "manifest_sha256",
        "status",
        "artifact_count",
        "relationship_count",
        "graph_schema_version",
        "graph_sha256"
      ],
      "properties": {
        "database_batch_id": {"type": "integer", "minimum": 1},
        "deterministic_batch_key": {"type": "string", "minLength": 1},
        "source_commit_sha": {"$ref": "#/$defs/sha40"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "applied"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "graph_schema_version": {
          "const": "editorial_persistence_batch_graph_v1"
        },
        "graph_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target_absence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_identities",
        "content_sha256",
        "activation_batch_key",
        "registry_primary_key",
        "results"
      ],
      "properties": {
        "schema_version": {
          "const": "editorial_publication_target_absence_v1"
        },
        "artifact_identities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_type", "natural_key", "artifact_version"],
            "properties": {
              "artifact_type": {"type": "string", "minLength": 1},
              "natural_key": {"type": "string", "minLength": 1},
              "artifact_version": {"const": 1}
            }
          }
        },
        "content_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active", "inactive"],
          "properties": {
            "active": {"$ref": "#/$defs/sha256"},
            "inactive": {"$ref": "#/$defs/sha256"}
          }
        },
        "activation_batch_key": {"type": "string", "minLength": 1},
        "registry_primary_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_bioguide_id", "issue_id"],
          "properties": {
            "member_bioguide_id": {"type": "string", "minLength": 1},
            "issue_id": {"type": "string", "minLength": 1}
          }
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_rows",
            "activation_batch_rows",
            "registry_rows",
            "partial_activation_relationships"
          ],
          "properties": {
            "artifact_rows": {"type": "array", "maxItems": 0},
            "activation_batch_rows": {"type": "array", "maxItems": 0},
            "registry_rows": {"type": "array", "maxItems": 0},
            "partial_activation_relationships": {"type": "array", "maxItems": 0}
          }
        }
      }
    },
    "fingerprint_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_batch_id",
        "deterministic_batch_key",
        "source_commit_sha",
        "manifest_sha256",
        "artifact_count",
        "relationship_count",
        "graph_sha256"
      ],
      "properties": {
        "database_batch_id": {"type": "integer", "minimum": 1},
        "deterministic_batch_key": {"type": "string", "minLength": 1},
        "source_commit_sha": {"$ref": "#/$defs/sha40"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "graph_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "count_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fingerprint_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_object_sha256",
        "batches",
        "artifact_set",
        "relationship_set",
        "registry",
        "target_absence",
        "target_absence_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "editorial_publication_pre_activation_fingerprint_v1"
        },
        "schema_object_sha256": {"$ref": "#/$defs/sha256"},
        "batches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/fingerprint_batch"}
        },
        "artifact_set": {"$ref": "#/$defs/count_hash"},
        "relationship_set": {"$ref": "#/$defs/count_hash"},
        "registry": {"$ref": "#/$defs/count_hash"},
        "target_absence": {"$ref": "#/$defs/target_absence"},
        "target_absence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reconciled_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "sha256"],
      "properties": {
        "input": {"$ref": "#/$defs/fingerprint_input"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_type",
        "natural_key",
        "schema_version",
        "artifact_version",
        "payload",
        "content_sha256",
        "source_manifest_sha256",
        "source_commit_sha",
        "member_bioguide_id",
        "issue_id",
        "congress",
        "chamber",
        "editorial_status",
        "benchmark_status",
        "production_eligible",
        "review_route"
      ],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit_sha": {"$ref": "#/$defs/sha40"},
        "payload": {"type": "object"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_natural_key",
        "child_natural_key",
        "relationship_type",
        "ordinal",
        "metadata"
      ],
      "properties": {
        "parent_natural_key": {"type": "string"},
        "child_natural_key": {"type": "string"},
        "relationship_type": {
          "enum": ["has_validation", "uses_source_manifest"]
        },
        "ordinal": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object"}
      }
    }
  }
}
