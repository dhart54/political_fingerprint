{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "created_at", "bundle_id", "bundle_sha256", "deployment_compatibility", "database_fingerprint", "inventory", "report_sha256"],
  "properties": {
    "schema_version": {"const": "editorial_publication_preflight_report_v1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplied_identity", "required_ancestor", "compatible", "verification_method"],
      "properties": {
        "supplied_identity": {"$ref": "#/$defs/sha40"},
        "required_ancestor": {"$ref": "#/$defs/sha40"},
        "compatible": {"const": true},
        "verification_method": {"const": "git_merge_base_is_ancestor"}
      }
    },
    "database_fingerprint": {"$ref": "#/$defs/sha256"},
    "inventory": {"$ref": "editorial_publication_backup_inventory_v1.schema.json"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
