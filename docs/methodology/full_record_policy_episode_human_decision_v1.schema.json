  "required": [
    "accepted",
    "artifact_id",
    "authorizing",
    "candidate_batch",
    "canonical",
    "decision_count",
    "decision_state",
    "decision_template_subject_sha256",
    "decisions",
    "downstream_authorizations",
    "explicit_non_acceptance",
    "public",
    "schema_version",
    "selected_batch_decision"
