{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cross_issue_full_record_expansion_v1.schema.json",
  "title": "M11A cross-issue expansion artifact family",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "milestone", "starting_commit", "subject", "cutoff", "excluded_domains", "complete_official_action_count", "complete_official_action_set_sha256", "production_snapshot", "candidate_domains", "eligible_domains_ranked", "selected_domain", "selection_state", "selection_basis", "selection_sha256", "next_stage_authorized"],
      "properties": {
        "schema_version": {"const": "cross_issue_domain_selection_v2"},
        "milestone": {"type": "string"},
        "starting_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "subject": {"type": "object"},
        "cutoff": {"type": "string", "format": "date"},
        "excluded_domains": {"type": "array", "uniqueItems": true},
        "complete_official_action_count": {"type": "integer", "minimum": 1},
        "complete_official_action_set_sha256": {"$ref": "#/$defs/sha256"},
        "production_snapshot": {"type": "object"},
        "candidate_domains": {"type": "array", "minItems": 6, "maxItems": 6},
        "eligible_domains_ranked": {"type": "array", "uniqueItems": true},
        "selected_domain": {"type": ["string", "null"]},
        "selection_state": {"enum": ["selected", "blocked_no_eligible_domain"]},
        "selection_basis": {"type": "array", "minItems": 1, "uniqueItems": true},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "next_stage_authorized": {"type": "boolean"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "milestone", "subject", "authority_status", "full_record_claim", "synthesis_eligible", "cutoff", "complete_member_action_count", "selection_sha256", "universe_subject_sha256", "accounting", "candidate_dispositions", "proposed_action_ids", "unresolved_action_ids", "episode_candidates_are_non_authorizing", "action_interpretation_started", "semantic_ir_started", "publication_changes", "production_writes"],
      "properties": {
        "schema_version": {"const": "cross_issue_universe_proposal_v1"},
        "milestone": {"type": "string"},
        "subject": {"type": "object"},
        "authority_status": {"const": "pending_human_universe_boundary_review"},
        "full_record_claim": {"const": false},
        "synthesis_eligible": {"const": false},
        "cutoff": {"type": "object"},
        "complete_member_action_count": {"type": "integer", "minimum": 1},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "universe_subject_sha256": {"$ref": "#/$defs/sha256"},
        "accounting": {"type": ["object", "null"]},
        "candidate_dispositions": {"type": "array"},
        "proposed_action_ids": {"type": "array", "uniqueItems": true},
        "unresolved_action_ids": {"type": "array", "uniqueItems": true},
        "episode_candidates_are_non_authorizing": {"const": true},
        "action_interpretation_started": {"const": false},
        "semantic_ir_started": {"const": false},
        "publication_changes": {"const": false},
        "production_writes": {"const": false}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "subject", "cutoff", "source_acquired_at", "complete_official_action_count", "source_roots", "selected_candidate_source_bindings", "inventory_sha256"],
      "properties": {
        "schema_version": {"const": "cross_issue_source_inventory_v1"},
        "subject": {"type": "object"},
        "cutoff": {"type": "string", "format": "date"},
        "source_acquired_at": {"type": "string", "format": "date-time"},
        "complete_official_action_count": {"type": "integer", "minimum": 1},
        "source_roots": {"type": "array", "minItems": 3, "maxItems": 3},
        "selected_candidate_source_bindings": {"type": "array"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
