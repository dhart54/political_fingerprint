{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Full-Record Synthesis Candidates V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_role",
    "subject",
    "public",
    "production_selectable",
    "synthesis_candidate_package_subject_sha256"
  ],
  "properties": {
    "schema_version": {"const": "full_record_synthesis_candidates_v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_role": {"const": "detached_non_authorizing_synthesis_candidate_package"},
    "public": {"const": false},
    "production_selectable": {"const": false},
    "synthesis_candidate_package_subject_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {
      "type": "object",
      "required": [
        "artifact_id",
        "member_bioguide_id",
        "member_slug",
        "issue_id",
        "congress",
        "chamber",
        "base_binding",
        "accepted_m11h_file_bindings",
        "source_authority_boundary",
        "m11h_authority_binding",
        "m11h_implementation_binding",
        "candidate_definitions",
        "synthesis_candidates",
        "complete_proposition_accounting",
        "proposition_accounting_counts",
        "candidate_overlap_accounting",
        "source_behavioral_proposition_count",
        "synthesis_candidate_count",
        "accepted_episode_disposition_ledger",
        "episode_disposition_accounting",
        "blocked_actions",
        "candidate_state",
        "accepted",
        "canonical",
        "authorizing",
        "downstream_authorizations"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "member_bioguide_id": {"type": "string", "minLength": 1},
        "member_slug": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "congress": {"type": "integer", "minimum": 1},
        "chamber": {"enum": ["House", "Senate"]},
        "base_binding": {"type": "object"},
        "accepted_m11h_file_bindings": {"type": "object"},
        "source_authority_boundary": {"type": "string", "minLength": 1},
        "m11h_authority_binding": {"$ref": "#/$defs/artifactSubjectBinding"},
        "m11h_implementation_binding": {"$ref": "#/$defs/artifactImplementationBinding"},
        "candidate_definitions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "synthesis_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/synthesisCandidate"}
        },
        "complete_proposition_accounting": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/propositionAccounting"}
        },
        "proposition_accounting_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "candidate_overlap_accounting": {"type": "array", "items": {"type": "object"}},
        "source_behavioral_proposition_count": {"type": "integer", "minimum": 1},
        "synthesis_candidate_count": {"type": "integer", "minimum": 1},
        "accepted_episode_disposition_ledger": {"type": "array", "minItems": 1},
        "episode_disposition_accounting": {"type": "object"},
        "blocked_actions": {"type": "array"},
        "candidate_state": {"const": "complete_pending_human_substantive_synthesis_review"},
        "accepted": {"const": false},
        "canonical": {"const": false},
        "authorizing": {"const": false},
        "downstream_authorizations": {"$ref": "#/$defs/downstream"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactSubjectBinding": {
      "type": "object",
      "required": ["artifact_id", "authority_subject_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "authority_subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactImplementationBinding": {
      "type": "object",
      "required": ["artifact_id", "implementation_subject_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "implementation_subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthesis_acceptance",
        "public_wording",
        "publication",
        "production_persistence",
        "database_writes",
        "production_writes",
        "deployment"
      ],
      "properties": {
        "synthesis_acceptance": {"const": false},
        "public_wording": {"const": false},
        "publication": {"const": false},
        "production_persistence": {"const": false},
        "database_writes": {"const": false},
        "production_writes": {"const": false},
        "deployment": {"const": false}
      }
    },
    "synthesisCandidate": {
      "type": "object",
      "required": [
        "synthesis_candidate_id",
        "semantic_role",
        "synthesis_type",
        "direction",
        "conclusion_relevance",
        "proposition",
        "input_bindings",
        "relationships",
        "underlying_evidence",
        "candidate_state",
        "accepted",
        "canonical",
        "authorizing",
        "downstream_authorizations",
        "synthesis_candidate_subject_sha256"
      ],
      "properties": {
        "synthesis_candidate_id": {"type": "string", "minLength": 1},
        "semantic_role": {"const": "synthesis"},
        "synthesis_type": {"enum": ["uniform_direction", "mechanism_divide", "interpretive_boundary", "no_common_throughline"]},
        "direction": {"enum": ["support", "opposition", "mixed", "non_directional"]},
        "conclusion_relevance": {"enum": ["primary", "limiting", "excluded"]},
        "proposition": {"type": "string", "minLength": 1},
        "input_bindings": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "relationships": {"type": "object"},
        "relationship_basis": {"type": "object"},
        "relationship_rationale": {"type": "string", "minLength": 1},
        "why_synthesis_not_topic_grouping": {"type": "string", "minLength": 1},
        "material_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "competing_interpretation": {"type": "string", "minLength": 1},
        "unresolved_ambiguity": {"type": "string", "minLength": 1},
        "prohibited_inferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "underlying_evidence": {"type": "object"},
        "candidate_state": {"const": "proposed_pending_human_synthesis_review"},
        "accepted": {"const": false},
        "canonical": {"const": false},
        "authorizing": {"const": false},
        "downstream_authorizations": {"$ref": "#/$defs/downstream"},
        "synthesis_candidate_subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "propositionAccounting": {
      "type": "object",
      "required": [
        "proposition_id",
        "implementation_record_id",
        "implementation_record_subject_sha256",
        "accepted_candidate_content_sha256",
        "source_proposition_type",
        "source_conclusion_relevance",
        "accounting_role",
        "candidate_relationships",
        "reason"
      ],
      "properties": {
        "proposition_id": {"type": "string", "minLength": 1},
        "implementation_record_id": {"type": "string", "minLength": 1},
        "implementation_record_subject_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_candidate_content_sha256": {"$ref": "#/$defs/sha256"},
        "source_proposition_type": {"enum": ["repeated_pattern", "trajectory", "notable_choice"]},
        "source_conclusion_relevance": {"enum": ["primary", "limiting", "excluded"]},
        "accounting_role": {"enum": ["primary_input", "contextual_input", "contrast_input", "limiting_input", "intentionally_standalone_no_safe_synthesis"]},
        "candidate_relationships": {"type": "array"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
