{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Full-Record Synthesis Decision Template V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "candidate_binding",
    "decision_state",
    "candidate_decisions",
    "reviewer",
    "reviewer_authority",
    "reviewed_at_utc",
    "authorizing",
    "downstream_authorizations",
    "decision_template_subject_sha256"
  ],
  "properties": {
    "schema_version": {"const": "full_record_synthesis_decision_template_v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "candidate_binding": {
      "type": "object",
      "required": ["artifact_id", "synthesis_candidate_package_subject_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "synthesis_candidate_package_subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision_state": {"const": "empty_pending_human_substantive_synthesis_review"},
    "candidate_decisions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["synthesis_candidate_id", "candidate_subject_sha256", "decision", "bounded_revision", "reviewer_notes"],
        "properties": {
          "synthesis_candidate_id": {"type": "string", "minLength": 1},
          "candidate_subject_sha256": {"$ref": "#/$defs/sha256"},
          "decision": {"type": "null"},
          "bounded_revision": {"type": "null"},
          "reviewer_notes": {"type": "null"}
        }
      }
    },
    "reviewer": {"type": "null"},
    "reviewer_authority": {"type": "null"},
    "reviewed_at_utc": {"type": "null"},
    "authorizing": {"const": false},
    "downstream_authorizations": {"type": "object", "additionalProperties": {"const": false}},
    "decision_template_subject_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
