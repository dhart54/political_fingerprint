{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "full_record_behavioral_semantic_ir_candidate_package_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_semantic_ir",
    "artifact_id",
    "authorizing",
    "base_binding",
    "blocked_action_ids",
    "candidate_state",
    "candidate_subject_sha256",
    "canonical_semantic_ir",
    "compiled_candidate_ir",
    "episode_evidence_ledger",
    "public_wording_included",
    "schema_version",
    "synthesis_included"
  ],
  "properties": {
    "schema_version": {"const": "full_record_behavioral_semantic_ir_candidate_package_v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "candidate_state": {"const": "complete_pending_human_substantive_review"},
    "base_binding": {"type": "object"},
    "m11f_authority_binding": {"type": "object"},
    "m11f_implementation_binding": {"type": "object"},
    "accepted_policy_episode_authority_binding": {"type": "object"},
    "accepted_policy_episode_implementation_binding": {"type": "object"},
    "blocked_action_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "episode_evidence_ledger": {"type": "array", "minItems": 1},
    "compiled_candidate_ir": {
      "type": "object",
      "required": ["downstream_authorizations", "episode_accounting", "proposition_graph", "schema_version", "subject", "synthesis_propositions"],
      "properties": {
        "schema_version": {"const": "behavioral_semantic_ir_candidate_graph_v1"},
        "subject": {"type": "object"},
        "proposition_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["propositions"],
          "properties": {
            "propositions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "conclusion_relevance",
                  "direction",
                  "evidence_action_ids",
                  "evidence_episode_ids",
                  "proposition_id",
                  "proposition_type",
                  "trajectory_change"
                ],
                "properties": {
                  "proposition_id": {"type": "string", "minLength": 1},
                  "proposition_type": {"enum": ["notable_choice", "repeated_pattern", "trajectory"]},
                  "direction": {"enum": ["support", "opposition", "mixed"]},
                  "conclusion_relevance": {"enum": ["primary", "limiting", "excluded"]},
                  "evidence_action_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "evidence_episode_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "trajectory_change": {
                    "oneOf": [
                      {"type": "null"},
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "accepted_after_direction",
                          "accepted_before_direction",
                          "accepted_chronology",
                          "bounded_change_description",
                          "change_type",
                          "ordered_evidence_episode_ids"
                        ],
                        "properties": {
                          "change_type": {"const": "direction_change"},
                          "ordered_evidence_episode_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
                          "accepted_chronology": {
                            "type": "array",
                            "minItems": 2,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["accepted_date", "episode_id"],
                              "properties": {
                                "episode_id": {"type": "string"},
                                "accepted_date": {"type": "string", "format": "date"}
                              }
                            }
                          },
                          "accepted_before_direction": {"type": "string"},
                          "accepted_after_direction": {"type": "string"},
                          "bounded_change_description": {"type": "string", "minLength": 1}
                        }
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {"properties": {"proposition_type": {"const": "trajectory"}}},
                    "then": {"properties": {"trajectory_change": {"type": "object"}}},
                    "else": {"properties": {"trajectory_change": {"type": "null"}}}
                  }
                ]
              }
            }
          }
        },
        "episode_accounting": {"type": "array", "minItems": 1},
        "synthesis_propositions": {"type": "array", "maxItems": 0},
        "downstream_authorizations": {"type": "object"}
      }
    },
    "accepted_semantic_ir": {"const": false},
    "canonical_semantic_ir": {"const": false},
    "synthesis_included": {"const": false},
    "public_wording_included": {"const": false},
    "authorizing": {"const": false},
    "candidate_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "oneOf": [
        {"required": ["m11f_authority_binding"]},
        {"required": ["accepted_policy_episode_authority_binding"]}
      ]
    },
    {
      "oneOf": [
        {"required": ["m11f_implementation_binding"]},
        {"required": ["accepted_policy_episode_implementation_binding"]}
      ]
    }
  ]
}
