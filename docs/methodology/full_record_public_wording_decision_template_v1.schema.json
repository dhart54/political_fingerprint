{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "full_record_public_wording_decision_template_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "candidate_binding", "decision_state", "wording_decisions", "reviewer", "reviewer_authority", "reviewed_at_utc", "authorizing", "production_selectable", "downstream_authorizations", "decision_template_subject_sha256"],
  "properties": {
    "schema_version": {"const": "full_record_public_wording_decision_template_v1"},
    "artifact_id": {"type": "string"},
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "public_wording_candidate_package_subject_sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "public_wording_candidate_package_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "decision_state": {"const": "empty_pending_human_substantive_wording_review"},
    "wording_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wording_item_id", "wording_item_subject_sha256", "decision", "bounded_revision", "reviewer_notes"],
        "properties": {
          "wording_item_id": {"type": "string"},
          "wording_item_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision": {"type": "null"},
          "bounded_revision": {"type": "null"},
          "reviewer_notes": {"type": "null"}
        }
      }
    },
    "reviewer": {"type": "null"},
    "reviewer_authority": {"type": "null"},
    "reviewed_at_utc": {"type": "null"},
    "authorizing": {"const": false},
    "production_selectable": {"const": false},
    "downstream_authorizations": {"type": "object", "additionalProperties": {"const": false}},
    "decision_template_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
