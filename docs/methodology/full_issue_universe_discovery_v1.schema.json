{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://political-fingerprint.local/schemas/full_issue_universe_discovery_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discovery_id",
    "discovery_version",
    "subject",
    "authority_status",
    "scope_claim",
    "full_record_claim",
    "synthesis_eligible",
    "cutoff",
    "read_only_session_proof",
    "query_allowlist_audit",
    "data_lineage",
    "complete_member_action_snapshot",
    "candidate_recall_set",
    "proposed_universe_set",
    "unresolved_candidate_set",
    "candidate_dispositions",
    "comparison",
    "classification_reconciliation",
    "benchmark_reconciliation",
    "public_api_reconciliation",
    "final_freshness_check",
    "source_gaps",
    "acquisition_gaps",
    "blockers",
    "proposed_manifest",
    "source_inventory",
    "universe_authority_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "full_issue_universe_discovery_v1"
    },
    "discovery_id": {
      "type": "string",
      "minLength": 1
    },
    "discovery_version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "$ref": "#/definitions/subject"
    },
    "authority_status": {
      "const": "pending_human_universe_review"
    },
    "scope_claim": {
      "const": "proposed_through_recorded_cutoff"
    },
    "full_record_claim": {
      "const": false
    },
    "synthesis_eligible": {
      "const": false
    },
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_as_of_utc",
        "latest_included_vote_date",
        "latest_production_member_vote_date",
        "latest_production_source_ingest_at",
        "latest_official_observed_vote_date",
        "acquisition_as_of_utc",
        "boundary",
        "production_snapshot_id",
        "production_snapshot_sha256"
      ],
      "properties": {
        "discovery_as_of_utc": {
          "type": "string",
          "format": "date-time"
        },
        "latest_included_vote_date": {
          "type": "string",
          "format": "date"
        },
        "latest_production_member_vote_date": {
          "type": "string",
          "format": "date"
        },
        "latest_production_source_ingest_at": {
          "type": "string",
          "format": "date-time"
        },
        "latest_official_observed_vote_date": {
          "type": "string",
          "format": "date"
        },
        "acquisition_as_of_utc": {
          "type": "string",
          "format": "date-time"
        },
        "boundary": {
          "$ref": "#/definitions/boundary"
        },
        "production_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "production_snapshot_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "read_only_session_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_transaction_read_only",
        "transaction_read_only",
        "transaction_isolation",
        "statement_timeout_ms",
        "lock_timeout_ms",
        "idle_in_transaction_session_timeout_ms",
        "application_name",
        "database_identity_sha256",
        "schema",
        "postgres_version",
        "connection_mode",
        "first_sql_command",
        "all_production_queries_inside_single_proven_transaction",
        "transaction_ended_with_rollback",
        "connection_closed"
      ],
      "properties": {
        "default_transaction_read_only": {
          "enum": [
            "on",
            "off"
          ]
        },
        "transaction_read_only": {
          "const": "on"
        },
        "transaction_isolation": {
          "const": "repeatable read"
        },
        "statement_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "lock_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "idle_in_transaction_session_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "application_name": {
          "type": "string",
          "minLength": 1
        },
        "database_identity_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "schema": {
          "const": "public"
        },
        "postgres_version": {
          "type": "string",
          "pattern": "^PostgreSQL "
        },
        "connection_mode": {
          "enum": [
            "direct_supabase",
            "supavisor_session_pooler",
            "supavisor_transaction_pooler"
          ]
        },
        "first_sql_command": {
          "const": "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY"
        },
        "all_production_queries_inside_single_proven_transaction": {
          "const": true
        },
        "transaction_ended_with_rollback": {
          "const": true
        },
        "connection_closed": {
          "const": true
        }
      }
    },
    "query_allowlist_audit": {
      "$ref": "#/definitions/queryAudit"
    },
    "data_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "production_objects",
          "stable_keys",
          "consumer_paths"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "production_objects": {
            "$ref": "#/definitions/nonemptyStrings"
          },
          "stable_keys": {
            "$ref": "#/definitions/nonemptyStrings"
          },
          "consumer_paths": {
            "$ref": "#/definitions/nonemptyStrings"
          }
        }
      }
    },
    "complete_member_action_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ids",
        "action_count",
        "action_set_sha256",
        "sanitized_records_sha256",
        "production_action_count",
        "repository_official_action_count"
      ],
      "properties": {
        "action_ids": {
          "$ref": "#/definitions/actionIds"
        },
        "action_count": {
          "type": "integer",
          "minimum": 1
        },
        "action_set_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "sanitized_records_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "production_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "repository_official_action_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidate_recall_set": {
      "$ref": "#/definitions/actionSet"
    },
    "proposed_universe_set": {
      "$ref": "#/definitions/actionSet"
    },
    "unresolved_candidate_set": {
      "$ref": "#/definitions/actionSet"
    },
    "candidate_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/candidateDisposition"
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_only_before_cutoff",
        "repository_official_only_before_cutoff",
        "official_only_after_cutoff",
        "duplicate_production_canonical_ids",
        "duplicate_official_canonical_ids",
        "conflicting_vote_or_measure_state",
        "benign_question_or_description_representation_differences"
      ],
      "properties": {
        "production_only_before_cutoff": {
          "$ref": "#/definitions/actionIds"
        },
        "repository_official_only_before_cutoff": {
          "$ref": "#/definitions/actionIds"
        },
        "official_only_after_cutoff": {
          "$ref": "#/definitions/actionIds"
        },
        "duplicate_production_canonical_ids": {
          "$ref": "#/definitions/actionIds"
        },
        "duplicate_official_canonical_ids": {
          "$ref": "#/definitions/actionIds"
        },
        "conflicting_vote_or_measure_state": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_id",
              "fields",
              "classification",
              "note"
            ],
            "properties": {
              "action_id": {
                "$ref": "#/definitions/actionId"
              },
              "fields": {
                "$ref": "#/definitions/nonemptyStrings"
              },
              "classification": {
                "enum": [
                  "benign_representation_difference",
                  "stale_derived_data",
                  "missing_acquisition",
                  "potential_production_defect",
                  "methodology_boundary_requiring_human_decision"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "benign_question_or_description_representation_differences": {
          "$ref": "#/definitions/actionIds"
        }
      }
    },
    "classification_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_primary_justice_set",
        "proposed_not_primary_justice",
        "primary_justice_not_proposed"
      ],
      "properties": {
        "production_primary_justice_set": {
          "$ref": "#/definitions/actionSet"
        },
        "proposed_not_primary_justice": {
          "$ref": "#/definitions/actionIds"
        },
        "primary_justice_not_proposed": {
          "$ref": "#/definitions/actionIds"
        }
      }
    },
    "benchmark_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_action_ids",
        "missing_action_ids",
        "all_present",
        "all_proposed_in_scope"
      ],
      "properties": {
        "expected_action_ids": {
          "$ref": "#/definitions/actionIds"
        },
        "missing_action_ids": {
          "$ref": "#/definitions/actionIds"
        },
        "all_present": {
          "const": true
        },
        "all_proposed_in_scope": {
          "const": true
        }
      }
    },
    "public_api_reconciliation": {
      "$ref": "#/definitions/publicApi"
    },
    "final_freshness_check": {
      "$ref": "#/definitions/finalFreshnessCheck"
    },
    "source_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classification",
          "action_ids",
          "counts_by_disposition",
          "boundary_review_effect",
          "later_stage_effect"
        ],
        "properties": {
          "classification": {"type": "string", "minLength": 1},
          "action_ids": {"$ref": "#/definitions/actionIds"},
          "counts_by_disposition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposed",
              "expressive",
              "procedural",
              "ineligible"
            ],
            "properties": {
              "proposed": {"type": "integer", "minimum": 0},
              "expressive": {"type": "integer", "minimum": 0},
              "procedural": {"type": "integer", "minimum": 0},
              "ineligible": {"type": "integer", "minimum": 0}
            }
          },
          "boundary_review_effect": {"type": "string", "minLength": 1},
          "later_stage_effect": {"type": "string", "minLength": 1}
        }
      }
    },
    "acquisition_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classification",
          "action_ids",
          "note"
        ],
        "properties": {
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "action_ids": {
            "$ref": "#/definitions/actionIds"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockers": {
      "$ref": "#/definitions/stringArray"
    },
    "proposed_manifest": {
      "$ref": "#/definitions/artifactReference"
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "path",
        "sha256"
      ],
      "properties": {
        "inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "universe_authority_receipt": {
      "type": "null"
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^(house|senate):[0-9]+:[0-9]+:[0-9]+$"
    },
    "actionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/actionId"
      }
    },
    "actionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ids",
        "action_count",
        "action_set_sha256"
      ],
      "properties": {
        "action_ids": {
          "$ref": "#/definitions/actionIds"
        },
        "action_count": {
          "type": "integer",
          "minimum": 0
        },
        "action_set_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "actionSetDigestComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_action_count",
        "baseline_action_set_sha256",
        "freshness_action_count",
        "freshness_action_set_sha256"
      ],
      "properties": {
        "baseline_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_action_set_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "freshness_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "freshness_action_set_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "issue_id",
        "congress_scope"
      ],
      "properties": {
        "member_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{6}$"
        },
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "congress_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "start_date",
        "end_date",
        "as_of_date",
        "chambers",
        "service_boundary"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "chambers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "house",
              "senate"
            ]
          }
        },
        "service_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queryAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_count",
        "query_audit_sha256",
        "query_ids",
        "all_queries_bounded_or_transaction_control"
      ],
      "properties": {
        "query_count": {
          "type": "integer",
          "minimum": 1
        },
        "query_audit_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "query_ids": {
          "$ref": "#/definitions/nonemptyStrings"
        },
        "all_queries_bounded_or_transaction_control": {
          "const": true
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "disposition",
        "evidence_basis",
        "source_references",
        "production_classification_state",
        "repository_acquisition_state",
        "official_source_state",
        "official_policy_area",
        "rationale",
        "confidence",
        "review_requirement",
        "benchmark_sample",
        "public_action_digest",
        "exact_action_source_binding",
        "source_readiness"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/definitions/actionId"
        },
        "disposition": {
          "enum": [
            "proposed_in_scope_substantive",
            "proposed_in_scope_non_directional",
            "procedural_context",
            "expressive_nonbinding_context",
            "proposed_exact_action_ineligible",
            "outside_service",
            "source_missing",
            "source_unresolved",
            "source_conflicting",
            "boundary_review_required"
          ]
        },
        "evidence_basis": {
          "$ref": "#/definitions/nonemptyStrings"
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_type",
              "source_id",
              "url"
            ],
            "properties": {
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "production_classification_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "primary_domain",
            "secondary_or_provisional_domains",
            "exact_action_eligible",
            "interpretation_status",
            "procedural_context"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "primary_domain": {
              "type": [
                "string",
                "null"
              ]
            },
            "secondary_or_provisional_domains": {
              "$ref": "#/definitions/stringArray"
            },
            "exact_action_eligible": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "interpretation_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "procedural_context": {
              "type": "boolean"
            }
          }
        },
        "repository_acquisition_state": {
          "const": "present"
        },
        "official_source_state": {
          "enum": [
            "clerk_and_congress_resolved",
            "clerk_resolved_congress_metadata_missing",
            "source_conflicting"
          ]
        },
        "official_policy_area": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "review_requirement": {
          "enum": [
            "human_universe_boundary_review",
            "none_for_discovery_disposition"
          ]
        },
        "benchmark_sample": {
          "type": "boolean"
        },
        "public_action_digest": {
          "$ref": "#/definitions/sha256"
        },
        "exact_action_source_binding": {
          "oneOf": [
            {
              "$ref": "#/definitions/exactActionSourceBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_readiness": {
          "$ref": "#/definitions/sourceReadiness"
        },
        "issue_memberships": {
          "$ref": "#/definitions/nonemptyStrings"
        },
        "cross_domain_scope_limitations": {
          "$ref": "#/definitions/nonemptyStrings"
        }
      }
    },
    "exactSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "url",
        "source_content_sha256",
        "source_subject",
        "text_version",
        "evidence_role",
        "digest_basis"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "source_content_sha256": {"$ref": "#/definitions/sha256"},
        "source_subject": {"type": "string", "minLength": 1},
        "text_version": {"type": "string", "minLength": 1},
        "evidence_role": {"type": "string", "minLength": 1},
        "digest_basis": {"type": "string", "minLength": 1}
      }
    },
    "exactActionSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_action_id",
        "exact_measure_or_amendment_identity",
        "house_action_stage",
        "vote_source_bindings",
        "exact_action_meaning_source_bindings",
        "boundary_review_sufficiency_state",
        "boundary_review_sufficiency_basis"
      ],
      "properties": {
        "canonical_action_id": {"$ref": "#/definitions/actionId"},
        "exact_measure_or_amendment_identity": {
          "type": "string",
          "minLength": 1
        },
        "house_action_stage": {"type": "string", "minLength": 1},
        "vote_source_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/exactSource"}
        },
        "exact_action_meaning_source_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/exactSource"}
        },
        "boundary_review_sufficiency_state": {
          "enum": ["sufficient", "insufficient"]
        },
        "boundary_review_sufficiency_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_review_source_state",
        "action_interpretation_source_state",
        "episode_construction_source_state",
        "synthesis_provenance_source_state",
        "remaining_source_gaps",
        "boundary_gap_nonblocking_reason"
      ],
      "properties": {
        "boundary_review_source_state": {
          "enum": ["sufficient", "insufficient"]
        },
        "action_interpretation_source_state": {
          "enum": ["not_started", "ready", "not_ready"]
        },
        "episode_construction_source_state": {
          "enum": ["not_started", "ready", "not_ready"]
        },
        "synthesis_provenance_source_state": {
          "enum": ["not_started", "ready", "not_ready"]
        },
        "remaining_source_gaps": {
          "$ref": "#/definitions/stringArray"
        },
        "boundary_gap_nonblocking_reason": {
          "type": ["string", "null"]
        }
      }
    },
