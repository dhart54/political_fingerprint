{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://political-fingerprint.local/schemas/full_issue_universe_authority_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "manifest_id", "manifest_sha256", "member_id", "issue_id", "review_scope", "boundary", "boundary_sha256", "action_set_sha256", "action_count", "source_manifest_identities", "universe_subject_sha256", "reviewer", "decision_timestamp", "decision"],
  "properties": {
    "schema_version": {"const": "full_issue_universe_authority_receipt_v1"},
    "receipt_id": {"type": "string", "pattern": "^universe-authority:[a-z0-9][a-z0-9._:-]+$"},
    "manifest_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "member_id": {"type": "string", "pattern": "^[A-Z][0-9]{6}$"},
    "issue_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "review_scope": {"const": "full_defined_issue_record"},
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["sessions", "start_date", "end_date", "as_of_date", "chambers", "service_boundary"],
      "properties": {
        "sessions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "as_of_date": {"type": "string", "format": "date"},
        "chambers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["house", "senate"]}},
        "service_boundary": {"type": "string", "minLength": 1}
      }
    },
    "boundary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_count": {"type": "integer", "minimum": 1},
    "source_manifest_identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "universe_subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_id", "authority"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "authority": {"const": "full_issue_universe_review_authority_v1"}
      }
    },
    "decision_timestamp": {"type": "string", "format": "date-time"},
    "decision": {"const": "approved_complete_issue_universe"},
    "approval_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_effect",
        "subject",
        "selected_domain",
        "official_cutoff",
        "complete_house_action_set",
        "selection",
        "universe_proposal",
        "approved_action_ids",
        "exclusion_categories",
        "source_inventory",
        "accepted_pull_request",
        "downstream_authorizations"
      ],
      "properties": {
        "authority_effect": {"const": "universe_membership_only"},
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_name", "member_id", "legislator_id", "chamber", "congress", "issue_id"],
          "properties": {
            "member_name": {"type": "string", "minLength": 1},
            "member_id": {"type": "string", "pattern": "^[A-Z][0-9]{6}$"},
            "legislator_id": {"type": "string", "minLength": 1},
            "chamber": {"const": "house"},
            "congress": {"type": "integer", "minimum": 1},
            "issue_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
          }
        },
        "selected_domain": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "official_cutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["end_date", "latest_action_id"],
          "properties": {
            "end_date": {"type": "string", "format": "date"},
            "latest_action_id": {"type": "string", "pattern": "^house:[0-9]+:[0-9]+:[0-9]+$"}
          }
        },
        "complete_house_action_set": {"$ref": "#/$defs/actionSetBinding"},
        "complete_official_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_path", "inventory_sha256", "file_sha256"],
          "properties": {
            "artifact_path": {"type": "string", "minLength": 1},
            "inventory_sha256": {"$ref": "#/$defs/sha256"},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_path", "sha256"],
          "properties": {
            "artifact_path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "universe_proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_path", "file_sha256", "universe_subject_sha256"],
          "properties": {
            "artifact_path": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "proposal_sha256": {"$ref": "#/$defs/sha256"},
            "universe_subject_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "approved_action_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^house:[0-9]+:[0-9]+:[0-9]+$"}
        },
        "exclusion_categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["procedural_context", "expressive_nonbinding_context", "exact_action_ineligible", "boundary_review_required"],
          "properties": {
            "procedural_context": {"$ref": "#/$defs/actionSetBindingWithMembers"},
            "expressive_nonbinding_context": {"$ref": "#/$defs/actionSetBindingWithMembers"},
            "exact_action_ineligible": {"$ref": "#/$defs/actionSetBindingWithMembers"},
            "boundary_review_required": {"$ref": "#/$defs/actionSetBindingWithMembers"}
          }
        },
        "source_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "artifact_path", "file_sha256", "inventory_sha256"],
          "properties": {
            "artifact_id": {"type": "string", "minLength": 1},
            "artifact_path": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "inventory_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "accepted_pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "head_sha"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        },
        "accepted_boundary_constraints": {"type": "object"},
        "held_domain_boundaries": {"type": "object"},
        "downstream_authorizations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_interpretation", "episode_acceptance", "semantic_ir", "synthesis", "public_wording", "publication", "production_persistence"],
          "properties": {
            "source_readiness": {"const": false},
            "action_interpretation": {"const": false},
            "episode_acceptance": {"const": false},
            "semantic_ir": {"const": false},
            "synthesis": {"const": false},
            "public_wording": {"const": false},
            "site_integration": {"const": false},
            "publication": {"const": false},
            "deployment": {"const": false},
            "production_persistence": {"const": false}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actionSetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "action_count", "action_set_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "action_count": {"type": "integer", "minimum": 0},
        "action_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actionSetBindingWithMembers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "action_count", "action_set_sha256", "action_ids"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "action_count": {"type": "integer", "minimum": 0},
        "action_set_sha256": {"$ref": "#/$defs/sha256"},
        "action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^house:[0-9]+:[0-9]+:[0-9]+$"}
        }
      }
    }
  }
}
