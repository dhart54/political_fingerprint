{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://political-fingerprint.local/schemas/full_record_synthesis_approval_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "member_id", "issue_id", "review_scope", "universe_manifest_id", "universe_manifest_sha256", "semantic_artifact_id", "semantic_artifact_sha256", "semantic_validation_receipt_id", "semantic_validation_receipt_sha256", "synthesis_outcome", "public_claim_class", "presentation_subject_sha256", "wording_ids", "mapping_ids", "limitation_ids", "provenance_ids", "reviewer", "decision_timestamp", "decision"],
  "properties": {
    "schema_version": {"const": "full_record_synthesis_approval_receipt_v1"},
    "receipt_id": {"type": "string", "pattern": "^full-synthesis-approval:[a-z0-9][a-z0-9._:-]+$"},
    "member_id": {"type": "string", "pattern": "^[A-Z][0-9]{6}$"},
    "issue_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "review_scope": {"const": "full_defined_issue_record"},
    "universe_manifest_id": {"type": "string", "minLength": 1},
    "universe_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semantic_artifact_id": {"type": "string", "minLength": 1},
    "semantic_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semantic_validation_receipt_id": {"type": "string", "minLength": 1},
    "semantic_validation_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "synthesis_outcome": {"type": "string", "minLength": 1},
    "public_claim_class": {"enum": ["full_issue_synthesis", "full_review_no_common_throughline", "full_review_no_safe_synthesis"]},
    "presentation_subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "wording_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mapping_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "authority"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "authority": {"const": "full_record_synthesis_review_authority_v1"}}},
    "decision_timestamp": {"type": "string", "format": "date-time"},
    "decision": {"const": "approved"}
  }
}
