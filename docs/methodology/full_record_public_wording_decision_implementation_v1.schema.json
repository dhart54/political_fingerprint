{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "full_record_public_wording_decision_implementation_v1.schema.json",
  "title": "Full-Record Public-Wording Decision Implementation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "subject", "implementation_subject_sha256"],
  "properties": {
    "schema_version": {"const": "full_record_public_wording_decision_implementation_v1"},
    "artifact_id": {"type": "string"},
    "implementation_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "required": ["authority_binding", "candidate_binding", "implementation_records", "complete_source_accounting", "complete_synthesis_role_accounting", "blocked_actions", "final_accounting", "canonical_reviewed_wording_present", "public", "production_selectable", "downstream_authorizations"],
      "allOf": [
        {"oneOf": [
          {"required": ["behavioral_semantic_ir_authority_binding", "behavioral_semantic_ir_implementation_binding", "synthesis_authority_binding", "synthesis_implementation_binding"]},
          {"required": ["m11h_authority_binding", "m11h_implementation_binding", "m11j_authority_binding", "m11j_implementation_binding"]}
        ]},
        {"oneOf": [
          {"required": ["blocked_action_boundaries"]},
          {"required": ["blocked_action_boundary"]}
        ]}
      ],
      "properties": {
        "implementation_records": {"type": "array", "minItems": 1},
        "canonical_reviewed_wording_present": {"const": true},
        "public": {"const": false},
        "production_selectable": {"const": false},
        "downstream_authorizations": {"$ref": "#/definitions/closedAuthorities"}
      }
    }
  },
  "definitions": {
    "closedAuthorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "production_persistence", "database_writes", "production_writes", "deployment"],
      "properties": {
        "publication": {"const": false},
        "production_persistence": {"const": false},
        "database_writes": {"const": false},
        "production_writes": {"const": false},
        "deployment": {"const": false}
      }
    }
  }
}
