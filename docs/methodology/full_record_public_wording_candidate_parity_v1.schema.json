{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "full_record_public_wording_candidate_parity_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "package_binding", "entries", "parity_subject_sha256"],
  "properties": {
    "schema_version": {"const": "full_record_public_wording_candidate_parity_v1"},
    "artifact_id": {"type": "string"},
    "package_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "public_wording_candidate_package_subject_sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "public_wording_candidate_package_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "file_sha256", "content_subject_sha256"],
        "properties": {
          "path": {"type": "string"},
          "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_subject_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "parity_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
