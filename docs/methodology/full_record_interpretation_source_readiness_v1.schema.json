{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "full_record_interpretation_source_readiness_v1.schema.json",
  "title": "Full-Record Interpretation Source Readiness V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_role",
    "input_bindings",
    "input_contract",
    "subject",
    "source_readiness_subject_sha256",
    "authorizations"
  ],
  "properties": {
    "schema_version": {"const": "full_record_interpretation_source_readiness_v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_role": {"const": "non_authorizing_source_readiness_only"},
    "input_bindings": {"$ref": "#/definitions/inputBindings"},
    "input_contract": {"$ref": "#/definitions/inputContract"},
    "subject": {"$ref": "#/definitions/subject"},
    "source_readiness_subject_sha256": {"$ref": "#/definitions/sha256"},
    "authorizations": {"$ref": "#/definitions/authorizations"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "inventory_sha256": {"$ref": "#/definitions/sha256"},
        "universe_subject_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_receipt", "universe_proposal", "selection", "source_inventory"],
      "properties": {
        "authority_receipt": {"$ref": "#/definitions/artifactBinding"},
        "universe_proposal": {"$ref": "#/definitions/artifactBinding"},
        "selection": {"$ref": "#/definitions/artifactBinding"},
        "source_inventory": {"$ref": "#/definitions/artifactBinding"}
      }
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowlisted_input_classes", "excluded_input_classes"],
      "properties": {
        "allowlisted_input_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_input_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "rawProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governed_local_path", "sha256"],
      "properties": {
        "governed_local_path": {
          "type": "string",
          "pattern": "^docs/editorial/full_record_reviews/source_readiness/evidence/[^.][^\\r\\n]*$"
        },
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "action_id",
        "source_id",
        "congress",
        "chamber",
        "exact_action_identity",
        "house_action_stage",
        "action_date",
        "roll_number",
        "member_action",
        "official_action_description",
        "official_purpose",
        "official_description",
        "text_version",
        "source_url",
        "raw_provenance_sha256"
      ],
      "properties": {
        "schema_version": {"const": "neutral_interpretation_source_projection_v1"},
        "action_id": {"type": "string", "pattern": "^house:[0-9]+:[12]:[1-9][0-9]*$"},
        "source_id": {"type": "string", "minLength": 1},
        "congress": {"type": "integer", "minimum": 1},
        "chamber": {"enum": ["house", "senate"]},
        "exact_action_identity": {"type": "string", "minLength": 1},
        "house_action_stage": {
          "enum": ["amendment", "final_passage_or_suspension_passage", "resolution_adoption"]
        },
        "action_date": {"type": "string", "format": "date"},
        "roll_number": {"type": "integer", "minimum": 1},
        "member_action": {"enum": ["yea", "nay", "present", "not_voting"]},
        "official_action_description": {"type": ["string", "null"]},
        "official_purpose": {"type": ["string", "null"]},
        "official_description": {"type": ["string", "null"]},
        "text_version": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https://"},
        "raw_provenance_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "source_subject",
        "content_class",
        "source_url",
        "raw_provenance",
        "neutral_projection",
        "neutral_projection_sha256"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": [
            "congress_gov_amendment_index",
            "congress_gov_bill_actions",
            "congress_gov_bill_text",
            "house_clerk_roll_call",
            "house_rules_committee_report"
          ]
        },
        "source_subject": {"type": "string", "minLength": 1},
        "content_class": {
          "enum": [
            "exact_amendment_purpose",
            "exact_house_action_record",
            "member_action_record",
            "operative_measure_text",
            "operative_resolution_text",
            "stage_compatible_senate_origin_text",
            "house_rules_report_final_text"
          ]
        },
        "source_url": {"type": "string", "pattern": "^https://"},
        "raw_provenance": {"$ref": "#/definitions/rawProvenance"},
        "neutral_projection": {"$ref": "#/definitions/projection"},
        "neutral_projection_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "roleBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_action_evidence",
        "exact_action_identity_and_stage_evidence",
        "operative_content_interpretation_input"
      ],
      "properties": {
        "member_action_evidence": {"$ref": "#/definitions/sourceIdList"},
        "exact_action_identity_and_stage_evidence": {"$ref": "#/definitions/sourceIdList"},
        "operative_content_interpretation_input": {"$ref": "#/definitions/sourceIdList"}
      }
    },
    "sourceIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_universe_member",
        "all_role_bindings_resolve",
        "official_source_types_and_hosts",
        "raw_and_projection_digests_valid",
        "neutral_projection_closed",
        "member_action_exact",
        "exact_action_identity",
        "house_stage_compatible",
        "operative_text_version_stage_compatible",
        "operative_content_present",
        "operative_context_sufficient",
        "no_source_conflict"
      ],
      "properties": {
        "approved_universe_member": {"type": "boolean"},
        "all_role_bindings_resolve": {"type": "boolean"},
        "official_source_types_and_hosts": {"type": "boolean"},
        "raw_and_projection_digests_valid": {"type": "boolean"},
        "neutral_projection_closed": {"type": "boolean"},
        "member_action_exact": {"type": "boolean"},
        "exact_action_identity": {"type": "boolean"},
        "house_stage_compatible": {"type": "boolean"},
        "operative_text_version_stage_compatible": {"type": "boolean"},
        "operative_content_present": {"type": "boolean"},
        "operative_context_sufficient": {"type": "boolean"},
        "no_source_conflict": {"type": "boolean"}
      }
    },
    "readinessState": {
      "enum": [
        "ready_for_action_interpretation",
        "blocked_missing_operative_content",
        "blocked_stage_mismatch",
        "blocked_exact_action_identity",
        "blocked_source_conflict",
        "blocked_insufficient_context"
      ]
    },
    "actionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "approved_universe_member",
        "congress",
        "session",
        "roll_number",
        "official_action_date",
        "official_member_action",
        "exact_action_identity",
        "mechanism_class",
        "house_action_stage",
        "source_conflict",
        "material_limitations",
        "source_roles",
        "sources",
        "readiness_criteria",
        "blocker_codes",
        "readiness_state",
        "source_packet_sha256"
      ],
      "properties": {
        "action_id": {"type": "string", "pattern": "^house:119:[12]:[1-9][0-9]*$"},
        "approved_universe_member": {"type": "boolean"},
        "congress": {"const": 119},
        "session": {"enum": [1, 2]},
        "roll_number": {"type": "integer", "minimum": 1},
        "official_action_date": {"type": "string", "format": "date"},
        "official_member_action": {"enum": ["yea", "nay", "present", "not_voting"]},
        "exact_action_identity": {"type": "string", "minLength": 1},
        "mechanism_class": {"enum": ["amendment", "whole_measure", "resolution"]},
        "house_action_stage": {
          "enum": ["amendment", "final_passage_or_suspension_passage", "resolution_adoption"]
        },
        "source_conflict": {"type": "boolean"},
        "material_limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_roles": {"$ref": "#/definitions/roleBindings"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source"}},
        "readiness_criteria": {"$ref": "#/definitions/criteria"},
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/readinessState"}
        },
        "readiness_state": {"$ref": "#/definitions/readinessState"},
        "source_packet_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_action_count", "ready_count", "blocked_count", "counts_by_readiness_state"],
      "properties": {
        "total_action_count": {"const": 82},
        "ready_count": {"type": "integer", "minimum": 0, "maximum": 82},
        "blocked_count": {"type": "integer", "minimum": 0, "maximum": 82},
        "counts_by_readiness_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ready_for_action_interpretation": {"type": "integer", "minimum": 0},
            "blocked_missing_operative_content": {"type": "integer", "minimum": 0},
            "blocked_stage_mismatch": {"type": "integer", "minimum": 0},
            "blocked_exact_action_identity": {"type": "integer", "minimum": 0},
            "blocked_source_conflict": {"type": "integer", "minimum": 0},
            "blocked_insufficient_context": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_name",
        "member_id",
        "legislator_id",
        "issue_id",
        "chamber",
        "congress",
        "official_cutoff",
        "action_ids",
        "action_set_sha256",
        "universe_subject_sha256",
        "criteria_version",
        "action_readiness",
        "aggregate"
      ],
      "properties": {
        "member_name": {"type": "string", "minLength": 1},
        "member_id": {"type": "string", "minLength": 1},
        "legislator_id": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "chamber": {"enum": ["house", "senate"]},
        "congress": {"type": "integer", "minimum": 1},
        "official_cutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["end_date", "latest_action_id"],
          "properties": {
            "end_date": {"type": "string", "format": "date"},
            "latest_action_id": {"type": "string", "minLength": 1}
          }
        },
        "action_ids": {
          "type": "array",
          "minItems": 82,
          "maxItems": 82,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "action_set_sha256": {"$ref": "#/definitions/sha256"},
        "universe_subject_sha256": {"$ref": "#/definitions/sha256"},
        "criteria_version": {"const": "full_record_interpretation_source_readiness_criteria_v1"},
        "action_readiness": {
          "type": "array",
          "minItems": 82,
          "maxItems": 82,
          "items": {"$ref": "#/definitions/actionRecord"}
        },
        "aggregate": {"$ref": "#/definitions/aggregate"}
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_interpretation",
        "episode_authority",
        "semantic_ir",
        "synthesis",
        "public_wording",
        "publication",
        "production_persistence"
      ],
      "properties": {
        "action_interpretation": {"const": false},
        "episode_authority": {"const": false},
        "semantic_ir": {"const": false},
        "synthesis": {"const": false},
        "public_wording": {"const": false},
        "publication": {"const": false},
        "production_persistence": {"const": false}
      }
    }
  }
}
