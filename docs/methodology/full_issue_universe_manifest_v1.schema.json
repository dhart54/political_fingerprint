{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://political-fingerprint.local/schemas/full_issue_universe_manifest_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_version", "subject", "boundary", "rules", "source_manifests", "action_ids", "action_count", "action_set_sha256", "snapshot_source_commit", "universe_subject_sha256"],
  "properties": {
    "schema_version": {"const": "full_issue_universe_manifest_v1"},
    "manifest_id": {"type": "string", "pattern": "^full-universe:[a-z0-9][a-z0-9._:-]+$"},
    "manifest_version": {"type": "integer", "minimum": 1},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["member_id", "issue_id", "congress_scope"],
      "properties": {
        "member_id": {"type": "string", "pattern": "^[A-Z][0-9]{6}$"},
        "issue_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "congress_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["sessions", "start_date", "end_date", "as_of_date", "chambers", "service_boundary"],
      "properties": {
        "sessions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "as_of_date": {"type": "string", "format": "date"},
        "chambers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["house", "senate"]}},
        "service_boundary": {"type": "string", "minLength": 1}
      }
    },
    "rules": {
      "type": "object", "additionalProperties": false,
      "required": ["inclusion", "exclusion"],
      "properties": {
        "inclusion": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusion": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source_manifests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "action_count": {"type": "integer", "minimum": 1},
    "action_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "universe_subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
