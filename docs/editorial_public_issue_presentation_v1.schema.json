{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://political-fingerprint.local/schemas/editorial_public_issue_presentation_v1.schema.json",
  "title": "Editorial Public Issue Presentation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_identity",
    "compiled_semantic_meaning",
    "editorial_wording",
    "frontend_display",
    "evidence_metadata",
    "provenance",
    "controls"
  ],
  "properties": {
    "schema_version": {"const": "editorial_public_issue_presentation_v1"},
    "artifact_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_id",
        "artifact_version",
        "member_id",
        "issue_id",
        "congress",
        "scope"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "integer", "minimum": 1},
        "member_id": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "congress": {"type": "integer", "minimum": 1},
        "scope": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "compiled_semantic_meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_proposition_ids",
        "limiting_proposition_ids",
        "propositions",
        "source_render_constraints",
        "review_route"
      ],
      "properties": {
        "primary_proposition_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "limiting_proposition_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "propositions": {
          "type": "array",
          "items": {"$ref": "#/definitions/proposition"}
        },
        "source_render_constraints": {"type": "array"},
        "review_route": {
          "enum": [
            "standard_generation_pass",
            "sampled_audit_candidate",
            "human_exception_required",
            "blocked"
          ]
        }
      }
    },
    "editorial_wording": {"type": "object"},
    "frontend_display": {"$ref": "#/definitions/frontendDisplay"},
    "evidence_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "action_ids", "episode_ids", "action_accounting"],
      "properties": {
        "coverage": {"type": "object"},
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^house:119:[0-9]+:[0-9]+$"
          },
          "uniqueItems": true
        },
        "episode_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "action_accounting": {"type": "object"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "semantic_source_case_id",
        "dossier_refs",
        "source_refs",
        "claim_refs",
        "receipt_refs",
        "compiled_ir_sha256",
        "review_receipt"
      ],
      "properties": {
        "compiled_ir_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "semantic",
        "editorial",
        "benchmark",
        "production",
        "publication",
        "review_receipt",
        "derived_semantic_tier",
        "effective_public_tier",
        "publication_gates_passed"
      ],
      "properties": {
        "derived_semantic_tier": {"$ref": "#/definitions/tier"},
        "effective_public_tier": {"$ref": "#/definitions/tier"},
        "publication_gates_passed": {"type": "boolean"}
      }
    }
  },
  "definitions": {
    "tier": {
      "enum": [
        "reviewed_conclusion",
        "developing_read",
        "non_directional_or_limited_evidence",
        "receipts_only"
      ]
    },
    "proposition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "proposition_id",
        "semantic_role",
        "proposition_type",
        "direction",
        "evidence_action_ids",
        "evidence_episode_ids",
        "presentation_target",
        "conclusion_relevance",
        "relationships"
      ]
    },
    "frontendDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "tier_badge",
        "teaser",
        "coverage_text",
        "scope_boundary",
        "conclusion",
        "repeated_patterns",
        "policy_trajectories",
        "limitations"
      ],
      "properties": {
        "tier": {"$ref": "#/definitions/tier"},
        "tier_badge": {"type": "string", "minLength": 1},
        "teaser": {"type": "string", "minLength": 1},
        "coverage_text": {"type": ["string", "null"]},
        "scope_boundary": {"type": ["string", "null"]},
        "conclusion": {"type": ["object", "null"]},
        "repeated_patterns": {"type": "array"},
        "policy_trajectories": {"type": "array"},
        "limitations": {"type": "array"}
      }
    }
  }
}
